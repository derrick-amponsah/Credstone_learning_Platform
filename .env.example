# ─────────────────────────────────────────────────────────
# Credstone Learning Platform - Root Environment
# ─────────────────────────────────────────────────────────

# Database
POSTGRES_USER=credstone
POSTGRES_PASSWORD=credstone
POSTGRES_DB=credstone
DATABASE_URL=postgres://credstone:credstone@db:5432/credstone

# Redis
REDIS_URL=redis://redis:6379

# Security
JWT_SECRET=credstone-super-secret-jwt-key-min-32-chars-long

# URLs
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
BACKEND_URL=http://api:4000

# MinIO / S3 Object Storage
S3_ENDPOINT=http://minio:9000
S3_BUCKET=credstone-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# Set to false if deploying to AWS S3 (true for MinIO, Cloudflare R2, Wasabi)
S3_FORCE_PATH_STYLE=true
